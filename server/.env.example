# ==========================================
# WorkHive Backend Environment Configuration (Template)
# ==========================================

PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and cluster address with your Atlas details:
MONGO_URI=mongodb+srv://<username>:<password>@workhivecluster.mongodb.net/workhive?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Frontend Application URL (for CORS)
CLIENT_URL=http://localhost:5173
